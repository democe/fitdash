msgid "Authorization code invalid or expired — please try again"
msgstr "அங்கீகாரக் குறியீடு தவறானது அல்லது காலாவதியானது - மீண்டும் முயற்சிக்கவும்"
#: package/contents/ui/FitbitOAuth.qml:388
msgid "Token exchange failed"
msgstr "டோக்கன் பரிமாற்றம் தோல்வியடைந்தது"
#: package/contents/ui/FitbitOAuth.qml:389
msgid "Token exchange failed — missing tokens"
msgstr "டோக்கன் பரிமாற்றம் தோல்வியடைந்தது - டோக்கன்கள் இல்லை"
#: package/contents/ui/FitbitOAuth.qml:390
msgid "Token exchange failed — invalid response"
msgstr "டோக்கன் பரிமாற்றம் தோல்வி - தவறான பதில்"
